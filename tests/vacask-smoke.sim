Circuit-Bench VACASK smoke test
// Bundled device models only (no PDK): an RC low-pass driven by a pulse, plus a
// resistor compiled from Verilog-A by the bundled OpenVAF-Reloaded.
load "resistor.osdi"
load "capacitor.osdi"
load "/tmp/vacask-smoke/vares.osdi"

model v vsource
model r resistor
model c capacitor
model rva vares r=1k

v1 (in 0) v type="pulse" val0=0 val1=1 rise=10p fall=10p width=100n delay=1n period=200n
r1 (in out) r r=1k
c1 (out 0) c c=10p
vdd (vdd 0) v dc=1
ra (vdd mid) rva
rb (mid 0) r r=3k

control
  analysis op1 op
  analysis tran1 tran step=10p stop=40n
endc
